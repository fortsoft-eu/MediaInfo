/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open…\tCtrl+O",              ID_FILE_OPEN
        MENUITEM "Open &Folder…",               ID_FILE_OPEN_FOLDER
        MENUITEM "&Close\tCtrl+W",              ID_FILE_CLOSE
        MENUITEM "Close &All",                  ID_FILE_CLOSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Export…\tCtrl+E",            ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Print…\tCtrl+P",             ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",               ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",         ID_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Find…\tCtrl+F",              ID_EDIT_FIND
        MENUITEM "Find &Next\tF3",              ID_EDIT_FIND_NEXT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Full Parsing",               ID_FULL_PARSING
        MENUITEM "&Advanced Mode",              ID_ADVANCED_MODE
        MENUITEM SEPARATOR
        MENUITEM "Trace Level &0",              ID_TRACE_LEVEL_0
        MENUITEM "Trace Level &5",              ID_TRACE_LEVEL_5
        MENUITEM "Trace Level &9",              ID_TRACE_LEVEL_9
        MENUITEM "Trace Level &10",             ID_TRACE_LEVEL_10
        MENUITEM SEPARATOR
        MENUITEM "&Word Wrap",                  ID_WORD_WRAP
        MENUITEM SEPARATOR
        MENUITEM "&Preferences…\tCtrl+G",       ID_PREFERENCES
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Create a &Header File…",      ID_TOOLS_CREATE_HEADER
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help\tF1",                   ID_HELP_CONTENTS
        MENUITEM SEPARATOR
        MENUITEM "Known &Formats",              ID_HELP_FORMATS
        MENUITEM "Known &Codecs",               ID_HELP_CODECS
        MENUITEM "Known &Parameters",           ID_HELP_PARAMETERS
        MENUITEM SEPARATOR
        MENUITEM "&About",                      ID_HELP_ABOUT
    END
END


